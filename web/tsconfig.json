{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable", "WebWorker"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "types": []
  },
  "include": ["cell-rt.ts", "shell/**/*.ts", "sim/**/*.ts", "page/**/*.ts", "../cells/*/ui/**/*.ts", "vendor/ui-cells/kit/dom.ts", "vendor/ui-cells/kit/faces.ts"]
}
